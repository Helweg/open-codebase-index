{
  "version": "1.0.0",
  "name": "expanded-click-definitions",
  "description": "Hand-curated exact definition queries for the pinned expanded public benchmark cohort.",
  "queries": [
    {
      "id": "click-echo",
      "query": "where is echo defined",
      "queryType": "definition",
      "retrievalMode": "context",
      "args": {
        "symbol": "echo"
      },
      "expected": {
        "filePath": "src/click/utils.py",
        "symbol": "echo",
        "expectedRoute": "definition"
      }
    },
    {
      "id": "click-prompt",
      "query": "where is prompt defined",
      "queryType": "definition",
      "retrievalMode": "context",
      "args": {
        "symbol": "prompt"
      },
      "expected": {
        "filePath": "src/click/termui.py",
        "symbol": "prompt",
        "expectedRoute": "definition"
      }
    },
    {
